{
  "knowledge_base_version": "1.0.0",
  "technology": {
    "company": "Stereotech",
    "name": "STE Slicer 5D/3D Multi-Axis Additive Manufacturing",
    "description": "Технология пятиосевой печати Stereotech (5D-печать) сочетает 3 линейные оси (X, Y, Z) и 2 поворотные оси наклона и вращения рабочего стола (оси B и C), обеспечивая укладку расплавленной полимерной нити по криволинейным траекториям в пространстве.",
    "key_benefits_5d": [
      "Увеличение прочности деталей до 400% за счет укладки непрерывных нитей вдоль линий главных механических напряжений и устранения межслойного расслоения по оси Z.",
      "Печать без вспомогательных поддержек (Support-Free) для нависающих элементов за счет постоянного поддержания нормали поверхности к соплу через наклон и вращение стола.",
      "Спиральная, цилиндрическая и сферическая укладка слоев для тел вращения, патрубков, шестерен, лопаток и армированных оболочек.",
      "Равномерная изотропия механических свойств готового изделия."
    ]
  },
  "mode_selection_rules": {
    "5D": {
      "name": "5D Multi-Axis (Пятиосевая печать)",
      "criteria": [
        "Деталь подвержена сложным пространственным механическим нагрузкам (изгиб, кручение, растяжение, сдвиг).",
        "Наличие консолей, нависаний под углом более 45-60 градусов, внутренних полостей, где невозможно или нежелательно удаление поддержек.",
        "Тела вращения: шестерни, зубчатые колеса, шкивы, фланцы, крыльчатки, фитинги, патрубки, втулки.",
        "Требуется максимальная прочность, сравнимая с литьем под давлением или фрезеровкой из алюминия.",
        "Габариты детали укладываются в безопасную рабочую зону поворотного стола без риска коллизий с печатающей головкой."
      ],
      "advantages": "Исключительная прочность по всем осям, отсутствие шероховатостей от поддержек, экономия материала до 50% и сокращение времени постобработки.",
      "limitations": "Требуется проверка коллизий инструмента с наклонным столом при экстремальных углах."
    },
    "3D": {
      "name": "3D Planar (Традиционная трехосевая печать)",
      "criteria": [
        "Простая призматическая или плоскопараллельная геометрия (плиты, корпуса с плоским основанием, кронштейны простой формы).",
        "Деталь работает преимущественно на сжатие вдоль оси Z или нагрузки действуют строго в плоскости XY.",
        "Быстрое прототипирование и макетная печать, где прочностные характеристики не являются критическими.",
        "Габариты детали превышают рабочий диапазон поворотного стола 5D-модуля, но помещаются на неподвижную платформу."
      ],
      "advantages": "Простота подготовки, максимальная площадь плоского основания для надежной адгезии, высокая скорость линейных перемещений.",
      "limitations": "Анизотропия прочности: межслойное сцепление по оси Z на 30-60% слабее, чем в плоскости слоя. Необходимость поддержек при углах нависания > 50°."
    }
  },
  "orientation_rules": {
    "mechanical_load_alignment": [
      "Линии укладки филамента обладают максимальной прочностью на растяжение вдоль волокна. Необходимо ориентировать модель так, чтобы траектории совпадали с направлением растягивающих и изгибающих сил.",
      "В режиме 5D ось вращения детали (ось симметрии) совмещается с осью поворотного стола C для спиральной или кольцевой непрерывной укладки.",
      "В режиме 3D наиболее нагруженные элементы и шейки валов должны располагаться горизонтально в плоскости XY, предотвращая срез по границам слоев."
    ],
    "support_free_rules": [
      "В режиме 5D деталь позиционируется так, чтобы поворотная ось B могла наклонять деталь в диапазоне 0..45..90 градусов, сохраняя угол между поверхностью наплавления и соплом близким к 90 градусам (печать без поддержек).",
      "В режиме 3D наибольшая плоская грань детали укладывается на стол для обеспечения максимальной адгезии и минимизации площади нависаний."
    ]
  },
